{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Clang 18 debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++-18",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANNDATA_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "sanitizers",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/sanitizers",
      "cacheVariables": {
        "ANNDATA_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "native-check",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": {
        "ANNDATA_BUILD_TESTS": "ON",
        "ANNDATA_BUILD_EXAMPLES": "ON",
        "ANNDATA_BUILD_BENCHMARKS": "OFF",
        "ANNDATA_ENABLE_INTEROP_TESTS": "OFF"
      }
    },
    {
      "name": "interop-check",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/interop",
      "cacheVariables": {
        "ANNDATA_BUILD_TESTS": "ON",
        "ANNDATA_BUILD_EXAMPLES": "ON",
        "ANNDATA_ENABLE_INTEROP_TESTS": "ON",
        "Python3_EXECUTABLE": "${sourceDir}/.venv/bin/python3"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers"
    },
    {
      "name": "native-check",
      "configurePreset": "native-check",
      "jobs": 2
    },
    {
      "name": "interop-check",
      "configurePreset": "interop-check",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "native-check",
      "configurePreset": "native-check",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "interop-check",
      "configurePreset": "interop-check",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "native-check",
      "displayName": "Configure, build, and verify the standalone foundation",
      "steps": [
        {
          "type": "configure",
          "name": "native-check"
        },
        {
          "type": "build",
          "name": "native-check"
        },
        {
          "type": "test",
          "name": "native-check"
        }
      ]
    },
    {
      "name": "interop-check",
      "displayName": "Build and compare to the workspace Python reference environment",
      "steps": [
        {
          "type": "configure",
          "name": "interop-check"
        },
        {
          "type": "build",
          "name": "interop-check"
        },
        {
          "type": "test",
          "name": "interop-check"
        }
      ]
    }
  ]
}
