@PACKAGE_INIT@
set(ANNDATAPP_HAS_HDF5 @ANNDATAPP_ENABLE_HDF5@)
set(ANNDATAPP_HAS_ZARR @ANNDATAPP_ENABLE_ZARR@)
include("${CMAKE_CURRENT_LIST_DIR}/anndatappModuleProvider.cmake")
if(NOT TARGET anndatapp::core)
  include("${CMAKE_CURRENT_LIST_DIR}/anndatappCoreTargets.cmake")
  _anndatapp_module_provider(anndatapp::core anndatapp::core_binary anndatapp_core_interfaces)
endif()
set(anndatapp_core_FOUND TRUE)
# No component means the complete facade, for existing consumers.
if(NOT anndatapp_FIND_COMPONENTS OR "anndatapp" IN_LIST anndatapp_FIND_COMPONENTS)
  if(NOT TARGET anndatapp::anndatapp)
    include(CMakeFindDependencyMacro)
    if(ANNDATAPP_HAS_HDF5)
      find_dependency(PkgConfig)
      pkg_check_modules(ANNDATAPP_HDF5 REQUIRED IMPORTED_TARGET GLOBAL hdf5>=1.10)
    endif()
    if(ANNDATAPP_HAS_ZARR)
      list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
      find_dependency(PkgConfig)
      pkg_check_modules(ANNDATAPP_ZLIB REQUIRED IMPORTED_TARGET GLOBAL zlib)
      pkg_check_modules(ANNDATAPP_ZSTD REQUIRED IMPORTED_TARGET GLOBAL libzstd)
      find_dependency(Blosc)
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/anndatappTargets.cmake")
    _anndatapp_module_provider(anndatapp::anndatapp anndatapp::anndatapp_binary anndatapp_module_interfaces anndatapp::core)
  endif()
  set(anndatapp_anndatapp_FOUND TRUE)
endif()
check_required_components(anndatapp)
