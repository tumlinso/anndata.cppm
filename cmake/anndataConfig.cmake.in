@PACKAGE_INIT@
set(ANNDATA_HAS_HDF5 @ANNDATA_ENABLE_HDF5@)
if(TARGET anndata::anndata)
  check_required_components(anndata)
  return()
endif()
if(@ANNDATA_ENABLE_HDF5@)
  include(CMakeFindDependencyMacro)
  find_dependency(PkgConfig)
  pkg_check_modules(ANNDATA_HDF5 REQUIRED IMPORTED_TARGET GLOBAL hdf5>=1.10)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/anndataTargets.cmake")

# CMake 3.28's Ninja generator emits duplicate synthetic module targets when
# two consumers link the same installed target with CXX_MODULES directly.
# Build the installed interfaces once in a normal target, which CMake can
# share across consumers, and expose a regular imported package target.
# The proxy copies only the binary/link properties; linking the original
# exported target here would reintroduce its imported module file set.
get_target_property(_anndata_binary_type anndata::anndata_binary TYPE)
if(_anndata_binary_type STREQUAL "STATIC_LIBRARY")
  add_library(anndata_cppm_binary_proxy STATIC IMPORTED GLOBAL)
elseif(_anndata_binary_type STREQUAL "SHARED_LIBRARY")
  add_library(anndata_cppm_binary_proxy SHARED IMPORTED GLOBAL)
else()
  message(FATAL_ERROR "Unsupported installed anndata binary type: ${_anndata_binary_type}")
endif()

get_target_property(_anndata_configurations anndata::anndata_binary IMPORTED_CONFIGURATIONS)
if(_anndata_configurations)
  set_property(TARGET anndata_cppm_binary_proxy PROPERTY IMPORTED_CONFIGURATIONS "${_anndata_configurations}")
endif()
foreach(_anndata_property IN ITEMS IMPORTED_LOCATION IMPORTED_IMPLIB IMPORTED_SONAME
    IMPORTED_NO_SONAME INTERFACE_LINK_LIBRARIES INTERFACE_LINK_OPTIONS)
  get_property(_anndata_is_set TARGET anndata::anndata_binary PROPERTY "${_anndata_property}" SET)
  if(_anndata_is_set)
    get_target_property(_anndata_value anndata::anndata_binary "${_anndata_property}")
    set_property(TARGET anndata_cppm_binary_proxy PROPERTY "${_anndata_property}" "${_anndata_value}")
  endif()
endforeach()
foreach(_anndata_configuration IN LISTS _anndata_configurations)
  foreach(_anndata_property IN ITEMS IMPORTED_LOCATION IMPORTED_IMPLIB IMPORTED_SONAME
      IMPORTED_NO_SONAME IMPORTED_LINK_DEPENDENT_LIBRARIES IMPORTED_LINK_INTERFACE_LANGUAGES)
    set(_anndata_configured_property "${_anndata_property}_${_anndata_configuration}")
    get_property(_anndata_is_set TARGET anndata::anndata_binary PROPERTY "${_anndata_configured_property}" SET)
    if(_anndata_is_set)
      get_target_property(_anndata_value anndata::anndata_binary "${_anndata_configured_property}")
      set_property(TARGET anndata_cppm_binary_proxy PROPERTY "${_anndata_configured_property}" "${_anndata_value}")
    endif()
  endforeach()
endforeach()

get_target_property(_anndata_module_files anndata::anndata_binary CXX_MODULE_SET)
get_target_property(_anndata_module_dirs anndata::anndata_binary CXX_MODULE_DIRS)
add_library(anndata_cppm_module_interfaces STATIC EXCLUDE_FROM_ALL)
set_target_properties(anndata_cppm_module_interfaces PROPERTIES
  CXX_EXTENSIONS OFF POSITION_INDEPENDENT_CODE ON)
target_sources(anndata_cppm_module_interfaces PUBLIC FILE_SET CXX_MODULES
  BASE_DIRS ${_anndata_module_dirs} FILES ${_anndata_module_files})
target_link_libraries(anndata_cppm_module_interfaces PUBLIC anndata_cppm_binary_proxy)

# Reuse the exported usage requirements rather than reconstructing flags.
foreach(_anndata_property IN ITEMS COMPILE_DEFINITIONS COMPILE_FEATURES COMPILE_OPTIONS)
  get_property(_anndata_is_set TARGET anndata::anndata_binary
    PROPERTY "IMPORTED_CXX_MODULES_${_anndata_property}" SET)
  if(_anndata_is_set)
    get_target_property(_anndata_value anndata::anndata_binary "IMPORTED_CXX_MODULES_${_anndata_property}")
    set_property(TARGET anndata_cppm_module_interfaces APPEND PROPERTY "${_anndata_property}" "${_anndata_value}")
  endif()
  get_property(_anndata_is_set TARGET anndata::anndata_binary
    PROPERTY "INTERFACE_${_anndata_property}" SET)
  if(_anndata_is_set)
    get_target_property(_anndata_value anndata::anndata_binary "INTERFACE_${_anndata_property}")
    set_property(TARGET anndata_cppm_module_interfaces APPEND PROPERTY "INTERFACE_${_anndata_property}" "${_anndata_value}")
  endif()
endforeach()

# An imported interface target keeps downstream install(EXPORT) dependencies
# expressed as anndata::anndata while using the shared local interface build.
add_library(anndata::anndata INTERFACE IMPORTED GLOBAL)
set_property(TARGET anndata::anndata PROPERTY INTERFACE_LINK_LIBRARIES anndata_cppm_module_interfaces)
check_required_components(anndata)
