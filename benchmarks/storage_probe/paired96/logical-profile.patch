+bool is_x_path(std::string_view path) noexcept { return path == "/X" || path == "X"; }
+std::uint64_t logical_elements(const std::vector<std::size_t>& shape) noexcept {
+    std::uint64_t result = 1;
+    for (const auto extent : shape) {
+        if (extent == 0) return 0;
+        if (result > UINT64_MAX / extent) return UINT64_MAX;
+        result *= extent;
+    }
+    return result;
+}
+__attribute__((destructor)) void report_x_backend_profile() {
